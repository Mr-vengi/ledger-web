{
  "name": "ledger-pdf-generator",
  "version": "1.0.0",
  "description": "Firebase Cloud Function for generating ledger PDFs with Tamil support",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "predeploy": "node copy-fonts.js",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "copy-fonts": "node copy-fonts.js"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "pdfmake": "^0.2.12",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}

